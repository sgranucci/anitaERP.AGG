[Unit]
Description=Ollama LLM (usuario sergio) para PDF IA comprobantes proveedor
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_FLASH_ATTENTION=0
Environment=PATH=%h/opt/ollama/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/opt/ollama/bin/ollama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
