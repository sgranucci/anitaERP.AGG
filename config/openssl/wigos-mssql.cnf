# OpenSSL mínimo para ODBC Driver 18 → SQL Server 2012 (Wigos).
# Solo se carga vía putenv(OPENSSL_CONF) antes de conectar Wigos (no afecta SOAP/ARCA).
openssl_conf = default_conf

[ default_conf ]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=0
