APP_NAME=Laravel
APP_ENV=local
# En production los comandos migrate:fresh, db:wipe, db:seed, etc. están bloqueados.
# ALLOW_DESTRUCTIVE_ARTISAN=true  # solo emergencia temporal; nunca dejar habilitado
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Subruta legacy (vacío si DocumentRoot ya es public/ y el dominio apunta a la raíz)
# APP_CARPETA=/anitaERP/public
# EMPRESA_LINK=/

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Precarga compras — log API agente proveedores (storage/logs/precarga_proveedor_api-YYYY-MM-DD.log)
PRECARGA_PROVEEDOR_API_LOG_CHANNEL=precarga_proveedor_api
# Comprobante proveedor — adjuntos bajo public/storage/{subdir}/{id}/
COMPROBANTE_PROVEEDOR_ARCHIVOS_SUBDIR=archivos/comprobantes_proveedor

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
# Nombre de la BD operativa; bloquea comandos destructivos aunque APP_ENV sea testing
DB_DATABASE_PROTEGIDA=
# Tests: phpunit.xml debe usar sqlite :memory:. En prod ejecutar solo con OK del operador:
# ALLOW_TEST_EXECUTION=1 ./scripts/guard-artisan-test.sh
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# database = colas reales (requiere worker: deploy/queue/aplicar-supervisor.sh)
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Compras / requisición: true = listado y EN_COMPRAS filtran por oficina de compra del usuario
REQUISICION_FILTRO_OFICINA_COMPRAS_ACTIVO=false

# true = al abrir el listado de artículos se sincroniza con Anita en la misma petición (riesgo de timeout)
ANITA_SYNC_ARTICULO_INDEX=false

# true = muestra el botón "Sincronizar desde Anita" en el índice de fórmulas de artículos (POST sigue bloqueado si es false)
ANITA_SYNC_FORMULA_ARTICULO_INDEX=true

# true = en el CRUD de fórmulas se muestra el "código" como número visible (listado, modal, título de edición,
# etiquetas de subfórmula, exportaciones) en lugar del id interno. Las URLs/rutas siguen usando id.
# Si una fórmula no tiene código cargado, se muestra "#<id>" como fallback.
FORMULA_ARTICULO_MOSTRAR_CODIGO_COMO_NUMERO=false

# Import masivo desde Anita sin pasar por el navegador (evita 504): php artisan articulo:sincronizar-anita
# Clientes nuevos/actualizados desde climae: php artisan cliente:sincronizar-anita
# Un solo cliente: php artisan cliente:sincronizar-anita --codigo=001234

# Órdenes de compra: sincronización desde pendmaep (misma lógica que requisiciones)
ORDENCOMPRA_SYNC_ANITA_INDEX=false
ORDENCOMPRA_SYNC_ANITA_FECHA_DESDE=20250100
# php artisan ordencompra:sincronizar-anita
# php artisan ordencompra:sincronizar-anita --nro=12345

# Recepción de proveedores (stock): contabilidad y bridge Anita
RECEPCION_PROVEEDOR_CONTABILIDAD_ACTIVA=true
RECEPCION_PROVEEDOR_ANITA_SISTEMA=compras
# stkmov Informix (recepción confirmada): ventas, no compras
RECEPCION_PROVEEDOR_ANITA_SISTEMA_VENTAS=ventas
# Clave t_comp en ventas para numerador COM (tcomp_refer → numerador.num_clave)
RECEPCION_PROVEEDOR_ANITA_T_COMP_CLAVE=COM
RECEPCION_PROVEEDOR_ANITA_CONTAB=contab
# true = permite subir foto/PDF en recepción y completar cantidades/precios por OCR
RECEPCION_PROVEEDOR_OCR_HABILITADO=true
# tesseract = operativo (pdftotext + tesseract); stub = solo guarda archivo
RECEPCION_PROVEEDOR_OCR_DRIVER=tesseract
RECEPCION_PROVEEDOR_OCR_TESSERACT_BIN=tesseract
RECEPCION_PROVEEDOR_OCR_TESSERACT_LANG=spa

# Transferencia de mercadería: modo aprobación (inmediata | tipo_transaccion | siempre)
STOCK_TRANSFERENCIA_MODO_APROBACION=tipo_transaccion
# Horas de validez de enlaces aprobar/rechazar en correo
STOCK_TRANSFERENCIA_HORAS_TOKEN=168
# SKUs TITO (precio promedio en asiento contable legacy)
STOCK_TRANSFERENCIA_SKUS_TITO=0000000201421,000100000-006,0000000201266,0000000201265
RECEPCION_PROVEEDOR_OCR_TESSERACT_PSM=4
# PSM adicionales separados por coma (11 = texto disperso; captura "Nro O.C.: 221067" en remitos)
RECEPCION_PROVEEDOR_OCR_TESSERACT_PSM_EXTRA=11
RECEPCION_PROVEEDOR_OCR_IMAGEN_MAX_ANCHO=2400
RECEPCION_PROVEEDOR_OCR_PDFTOTEXT_BIN=pdftotext
RECEPCION_PROVEEDOR_OCR_PDFTOPPM_BIN=pdftoppm
RECEPCION_PROVEEDOR_OCR_PDF_MIN_CHARS=40
RECEPCION_PROVEEDOR_OCR_PDF_MAX_PAGINAS=3
RECEPCION_PROVEEDOR_OCR_DPI_PDF=300
RECEPCION_PROVEEDOR_OCR_TIMEOUT=120
# Directorio temporal OCR (debe ser escribible por www-data; evitar storage/app/tmp si tiene permisos 700)
RECEPCION_PROVEEDOR_OCR_TMP_DIR=/tmp/anitaerp-ocr
RECEPCION_PROVEEDOR_OCR_IMAGEN_JPEG_CALIDAD=88
# Completar EAN-13 truncado por OCR (false = priorizar cantidad; barcode solo si viene entero)
RECEPCION_PROVEEDOR_OCR_COMPLETAR_EAN=false
# Prefijos para detectar OC de 6 dígitos sin etiqueta (coma-separados, ej. 2 → 221067)
RECEPCION_PROVEEDOR_OCR_OC_PREFIJOS=2
RECEPCION_PROVEEDOR_STK_PARTE_UNICA_SISTEMA=base_admin
# Estados Anita recepmae.recm_estado: 2=confirmada, 3=anulada
RECEPCION_PROVEEDOR_ANITA_ESTADO_CONFIRMADA=2
RECEPCION_PROVEEDOR_ANITA_ESTADO_ANULADA=3
# Tolerancias default (empresa sin regla en BD) y detección laboratorio
RECEPCION_PROVEEDOR_TOL_CANTIDAD_PCT=0
RECEPCION_PROVEEDOR_TOL_PRECIO_PCT=0
RECEPCION_PROVEEDOR_TOL_PRECIO_ABS=0
# Máx. diferencia recepción vs asiento al confirmar (moneda recepción)
RECEPCION_PROVEEDOR_TOL_CUADRE_CONTABLE=0.02
RECEPCION_PROVEEDOR_SKU_PREFIJO_LAB=LAB
RECEPCION_PROVEEDOR_USOARTICULO_LAB_IDS=3
# Encuesta a proveedor post-recepción (link legacy genera_proveedor_encuesta)
RECEPCION_PROVEEDOR_ENCUESTA_HABILITADA=true
RECEPCION_PROVEEDOR_ENCUESTA_ID=1
# Modal catálogo articulo_proveedor al guardar recepción (AGG: true; false si no se usa)
RECEPCION_PROVEEDOR_MODAL_ARTICULO_PROVEEDOR=false

# Lista de precios por defecto en modal de consulta de artículos (id numérico, típ. 1).
# LISTAPRECIO_DEFAULT_ID=1

# Impuesto interno (p. ej. cigarrillos): coeficientes por insumo en listas de precios.
# Mapa empresa_id => código de listaprecio del coeficiente (vigente al facturar).
# Default AGG: BIYEMAS=162, KANDIKO=262, REBISCO=362.
# Si un ítem facturado tiene en su fórmula (insumos o opcionales elegidos) un artículo con
# tipoarticulo configurado abajo, se aplica precio*coef como impuesto interno y se descuenta
# del bruto antes de calcular el neto/IVA. El total del concepto se agrega a la factura y
# se reporta a ARCA como tributo Id=4 (Impuestos Internos).
# FACTURACION_IMPUESTO_INTERNO_LISTAS_POR_EMPRESA={"1":"162","2":"262","3":"362"}
# FACTURACION_IMPUESTO_INTERNO_TIPOARTICULO_NOMBRE=CIGARRILLO

# Mesas gastronomía: sincronización desde tabla mesa (Anita)
MESA_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_MESA_GASTRONOMIA_INDEX=true
MESA_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# MESA_GASTRONOMIA_SYNC_EMPRESA_ID=1
# php artisan mesa-gastronomia:sincronizar-anita
# php artisan mesa-gastronomia:sincronizar-anita --codigo=12

# Descuentos gastronomía: sincronización desde tabla descuento (Anita)
DESCUENTO_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_DESCUENTO_GASTRONOMIA_INDEX=true
DESCUENTO_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# php artisan descuento-gastronomia:sincronizar-anita
# php artisan descuento-gastronomia:sincronizar-anita --codigo=1

# Mozos gastronomía: sincronización desde tabla vendedor (Anita)
MOZO_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_MOZO_GASTRONOMIA_INDEX=true
MOZO_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# MOZO_GASTRONOMIA_SYNC_EMPRESA_ID=1
# php artisan mozo-gastronomia:sincronizar-anita
# php artisan mozo-gastronomia:sincronizar-anita --codigo=12

# Categorías fidelidad gastronomía: clicat + clicatart + entregas clicatent (Anita)
CATEGORIA_FIDELIDAD_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_CATEGORIA_FIDELIDAD_GASTRONOMIA_INDEX=true
# Clientes VIP canjes gastronomía (base_admin.clivipg)
ANITA_SYNC_CLIENTE_VIP_GASTRONOMIA_INDEX=true
ANITA_SYNC_CLIENTE_VIP_GASTRONOMIA_WRITE=true
CATEGORIA_FIDELIDAD_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# Fecha mínima Ymd para importar entregas clicatent (20250101 = 1/1/2025)
CATEGORIA_FIDELIDAD_GASTRONOMIA_SYNC_ANITA_FECHA_DESDE=20250101
# clcent_categoria=0 en Anita → categoría ERP por defecto (3 = Platino)
CATEGORIA_FIDELIDAD_GASTRONOMIA_ENTREGA_CATEGORIA_DEFAULT=3
# php artisan categoria-fidelidad-gastronomia:sincronizar-anita
# php artisan categoria-fidelidad-gastronomia:sincronizar-anita --codigo=1

# Puntos de venta: sincronización desde tabla sucursal (Anita)
ANITA_SYNC_PUNTOVENTA_INDEX=false
# Replicar altas/ediciones/bajas del ABM hacia Anita (tabla sucursal). Dejar en false mientras se ajustan empresas/PV.
ANITA_SYNC_PUNTOVENTA_WRITE=false
# PUNTOVENTA_SYNC_ANITA_SISTEMA=ventas
# PUNTOVENTA_SYNC_EMPRESA_ID=3
# Lista de columnas Informix (si el default falla o devuelve 0 filas, copie aquí las columnas reales):
# PUNTOVENTA_SYNC_ANITA_CAMPOS_LISTADO=suc_numero,suc_empresa,...
# PUNTOVENTA_SYNC_DEFAULT_PAIS_ID=1
# PUNTOVENTA_SYNC_DEFAULT_PROVINCIA_ID=3
# PUNTOVENTA_SYNC_DEFAULT_LOCALIDAD_ID=108
# php artisan puntoventa:sincronizar-anita
# php artisan puntoventa:sincronizar-anita --codigo=1

# Gastronomía POS: la empresa la define configuracion_puntoventa_gastronomia por identificador de PC.
# Identificador de terminal (hostname servidor si no se define)
# GASTRONOMIA_IDENTIFICADOR_PC=caja1
# true = usar IP del cliente HTTP como identificador (TrustProxies debe confiar el proxy/nginx)
GASTRONOMIA_IDENTIFICADOR_USAR_IP_CLIENTE=false
# true = habilitación/cierre de turno por PC antes de facturar (AGG). false = caja directo.
GASTRONOMIA_REQUIERE_HABILITACION_TURNO=true
# Apertura de mesa/cuenta en el POS
# GASTRONOMIA_CUBIERTOS_OBLIGATORIO_AL_ABRIR=true
# GASTRONOMIA_CUBIERTOS_DEFAULT_AL_ABRIR=1
# GASTRONOMIA_MOZO_OBLIGATORIO_AL_ABRIR=true
# GASTRONOMIA_CUENTAS_LIBRES_HABILITADAS=true
# Anita al facturar: replica venta en Informix vía bridge al emitir desde el POS.
# GASTRONOMIA_SINCRONIZAR_ANITA=true
# true = venta + vengrav + stkmov + vencae (gastronomía). false = grabaAnita completo como Ventas.
# GASTRONOMIA_ANITA_MODO_MINIMO=true
# false = no replica stkmov de insumos por fórmula al facturar (solo ERP; auditoría diaria puede replicar faltantes)
# GASTRONOMIA_ANITA_REPLICAR_INSUMOS_AL_FACTURAR=true
# true = graba Anita después del commit MySQL (solo Anita; CAE/ARCA sigue en transacción con rollback)
# GASTRONOMIA_ANITA_TRAS_COMMIT_AL_FACTURAR=true
# true = Anita después de responder al POS (no bloquea emitir-factura)
# GASTRONOMIA_ANITA_TRAS_RESPUESTA=true

# Auditoría diaria ERP ↔ Anita (schedule: gastronomia:auditoria-anita-diaria @ GASTRONOMIA_AUDITORIA_ANITA_HORA)
# Día auditado = ayer calendario (venta.fecha). Busca comprobante en Anita por sucursal+tipo+nro+letra B.
# Replica faltantes y envía mail si hay alertas (faltantes, errores, delta de total).
# GASTRONOMIA_AUDITORIA_ANITA_DIARIA=true
# GASTRONOMIA_AUDITORIA_ANITA_HORA=06:30
# GASTRONOMIA_AUDITORIA_ANITA_EMPRESA_ID=1
# GASTRONOMIA_AUDITORIA_ANITA_EMPRESAS_IDS=1,2,3
# GASTRONOMIA_AUDITORIA_ANITA_USUARIO_ID=1
# GASTRONOMIA_AUDITORIA_ANITA_EMAIL=sergiogranucci@gmail.com
# GASTRONOMIA_AUDITORIA_ANITA_TOLERANCIA=0.02
# GASTRONOMIA_AUDITORIA_ANITA_REPLICAR_INSUMOS=true
# GASTRONOMIA_AUDITORIA_ANITA_EMAIL_SI_OK=false

# Reporte conciliación diaria ERP / Anita / rendgastro (schedule @ GASTRONOMIA_CONCILIACION_DIARIA_HORA, tras auditorías)
# GASTRONOMIA_CONCILIACION_DIARIA_HABILITADA=true
# GASTRONOMIA_CONCILIACION_DIARIA_HORA=08:00
# GASTRONOMIA_CONCILIACION_DIARIA_EMPRESAS_IDS=1,2,3
# GASTRONOMIA_CONCILIACION_DIARIA_EMAIL=sergiogranucci@gmail.com
# GASTRONOMIA_CONCILIACION_DIARIA_TOLERANCIA=0.02
# Rebisco: jornadas anteriores = pre-migración ERP (no conciliar en reporte diario)
# GASTRONOMIA_CONCILIACION_REBISCO_JORNADA_DESDE=2026-06-10

# Waitry después de responder al POS (no bloquea emitir-factura)
# GASTRONOMIA_WAITRY_TRAS_RESPUESTA=true
# GASTRONOMIA_EMISION_PROFILE=false
# GASTRONOMIA_EMISION_PROFILE_EN_RESPUESTA=false
# Umbral (ms) para log warning gastronomia.emision.lento (default 10000)
# GASTRONOMIA_EMISION_UMBRAL_ADVERTENCIA_MS=10000
# Ticket térmico post-emisión en defer (no bloquea respuesta al POS)
# GASTRONOMIA_TICKET_IMPRESION_ASYNC=true
# Una sola emisión a la vez por punto de venta fiscal (número ARCA). Segundos de vida del lock en cache.
# GASTRONOMIA_EMISION_LOCK_SEGUNDOS=180

# Numeración tesorería (cobranza + movimiento de caja / Anita tesmov).
# Compartida por empresa_id + tipotransaccion_caja_id: gastronomía al cobrar, ABM cobranza, ingreso/egreso.
# Requiere CACHE_DRIVER con locks (file, redis, database; no array en producción con varias PCs).
# COBRANZA_NUMERACION_LOCK_SEGUNDOS=120
# COBRANZA_NUMERACION_LOCK_ESPERA_SEGUNDOS=90
# Tipos de transacción de caja con numerador secuencial (1,2,…). Gastronomía suele ser id 2 → clave B-00008-00807543 desde ARCA.
# COBRANZA_TIPOTRANSACCION_SECUENCIAL_IDS=1

# Descuentos en cobranza → nota de crédito fiscal (ARCA) al confirmar/grabar
# COBRANZA_DESCUENTO_NC_HABILITADO=true
# JSON empresa_id => puntoventa_id para emitir NC de descuentos
# COBRANZA_NC_PUNTOVENTA_POR_EMPRESA={"1":5}
# Tipo transacción NC (signo Resta); opcional mapa por letra A/B/C
# COBRANZA_NC_TIPOTRANSACCION_ID=4
# COBRANZA_NC_TIPOTRANSACCION_POR_LETRA={"A":4,"B":4}
# Artículo del renglón NC (id o sku por empresa)
# COBRANZA_NC_ARTICULO_ID=133
# COBRANZA_NC_ARTICULO_SKU=

# Canje ticket tarjeta gastronomía (CTG) — cobranza en facturador, tabla Informix tickettarj
# Código de barras: 6 dígitos imovimientoid + inroticket. Impreso: 554101-52547. EAN (13 dígitos):
# 5541010525473 = movimiento + 0 + nroticket (6) + dígito verificador. Sin guión: 55365952217 → 553659/52217.
# GASTRONOMIA_TICKET_TARJETA_ANITA_SISTEMA = base Informix del bridge (config/anita.php ANITA_BDD_PATH + sistema).
#   base_admin = default histórico tickettarj. ventas = misma tabla en otras instalaciones.
#   NO usar che_ban (cuentas bancarias/cheques): ahí no está tickettarj → "No se encontró el ticket en Anita".
# Cuenta de caja del medio de cobranza (debe existir por empresa):
# GASTRONOMIA_TICKET_TARJETA_CUENTACAJA_CODIGO=CTG
# GASTRONOMIA_TICKET_TARJETA_VENCIMIENTO_DIAS=30
# GASTRONOMIA_TICKET_TARJETA_TOLERANCIA_EXCEDENTE=5
# Bridge Anita por empresa (canje CTG). Biyemas: ANITA_IP + IFX_SERVER global (bincadmin/bi7ncadmin).
# Kandiko (2): 192.168.20.100 + kancadmin. Rebisco (3): 192.168.40.100 + rencadmin. Sistema: base_admin (global).
# GASTRONOMIA_TICKET_TARJETA_ANITA_POR_EMPRESA={"2":{"servidor":"192.168.20.100:8080","path_sistema":"/usr2/biyemas","ifx_server":"kancadmin"},"3":{"servidor":"192.168.40.100:8080","path_sistema":"/usr2/biyemas","ifx_server":"rencadmin"}}
GASTRONOMIA_TICKET_TARJETA_ANITA_SISTEMA=base_admin

# Clientes VIP canjes (tabla Anita clivipg en base_admin). Sync: Biyemas(1) → Kandiko(2) → Rebisco(3).
GASTRONOMIA_CLIENTE_VIP_ANITA_SISTEMA=base_admin
GASTRONOMIA_CLIENTE_VIP_ANITA_TABLA=clivipg

# Cierre de jornada — órdenes Waitry del tótem (waitry_order_id). PDF y rango al cerrar jornada gastronomía.
# Requiere WAITRY_HABILITADO=true. Siguiente día: órdenes con id > último waitry_order_id_hasta guardado.
# GASTRONOMIA_CIERRE_TOTEM_JORNADA_HABILITADO=true
# GASTRONOMIA_CIERRE_TOTEM_MAX_ORDENES=15000
# GASTRONOMIA_CIERRE_TOTEM_MAX_LINEAS_DETALLE=3000
# Huecos de secuencia Waitry: ya no se recuperan al cerrar jornada (quedan para auditoría del día).
# GASTRONOMIA_CIERRE_TOTEM_MAX_IDS_GAP_RECUPERAR=0
# Máx. consultas getOrdersPOS por orderId si getordersdetails no trae payment.type (0 = off)
# GASTRONOMIA_CIERRE_TOTEM_ENRIQUECER_PAYMENT_INDIVIDUAL_MAX=0
# GASTRONOMIA_CIERRE_TOTEM_HORA_CORTE_MADRUGADA=7
# GASTRONOMIA_CIERRE_TOTEM_INFORME_Z_TOLERANCIA=0.02
# Punto de venta del proceso inferior de cierre Waitry (JSON empresa_id → código PV CAEA).
# Biyemas 00020, Kandiko 00031, Rebisco 00030.
# GASTRONOMIA_CIERRE_JORNADA_PUNTOVENTA_CODIGO_POR_EMPRESA={"1":"00020","2":"00031","3":"00030"}
# Memoria PHP cierre Waitry (Informe Z jornada, analizar tramo, recalcular %, detalle cuadro)
# GASTRONOMIA_CIERRE_JORNADA_PROCESO_MEMORY_LIMIT=1024M
# Cuentas contables default del proceso (prioridad: tabla gastronomia_cierre_jornada_config por empresa)
# GASTRONOMIA_CIERRE_JORNADA_CUENTA_VENTAS_ID=
# GASTRONOMIA_CIERRE_JORNADA_CUENTA_IVA_ID=
# GASTRONOMIA_CIERRE_JORNADA_CUENTA_VENTAS_KIOSCO_ID=
# GASTRONOMIA_CIERRE_JORNADA_CUENTA_DIFERENCIA_CAJA_ID=
# Tipo transacción stock ajuste por consumo (salida) al emitir factura del proceso cierre Waitry
# GASTRONOMIA_CIERRE_JORNADA_TIPOTRANSACCION_STOCK_AJUSTE_CONSUMO_ID=7
# Abreviatura tipo asiento contable al grabar asientos del proceso cierre Waitry
# GASTRONOMIA_CIERRE_JORNADA_TIPOASIENTO_ABREVIATURA=VTA
# Importación/backfill facturas gastronomía Anita → ERP (gastronomia:importar-facturas-anita / backfill-ventas-anita-erp)
# GASTRONOMIA_ANITA_IMPORT_EMPRESA_ID=1
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_3=10.20.30.98
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_5=10.20.29.40
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_8=10.20.30.92
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_15=192.168.20.152
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_20=10.20.30.92
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_31=192.168.20.152
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_34=192.168.40.142
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_30=192.168.40.142
# GASTRONOMIA_ANITA_IMPORT_PC_SUCURSAL_35=192.168.40.227
# GASTRONOMIA_ANITA_IMPORT_CONTABILIDAD_COBRANZA=false
# Cierre contable de período y aperturas programadas (config/contable_cierre.php)
CONTABLE_CIERRE_RECORDATORIO_HORAS=2
CONTABLE_CIERRE_JOB_INTERVALO_MIN=15
CONTABLE_CIERRE_APERTURA_LINK_DIAS=7
# Saldos mensuales por cuenta (cuentacontable_saldo_mes; reconstruir: contable:reconstruir-saldos-cuenta-mes)
CONTABLE_SALDOS_CUENTA_MES_OBSERVER=false
CONTABLE_SALDOS_CUENTA_MES_MONEDA_LOCAL_ID=1
# Mayor por concepto — cierre mensual; subir si meses muy cargados (config/contable.php)
MAYOR_CONCEPTO_MEMORY_LIMIT=1024M
MAYOR_CONCEPTO_MAX_EXECUTION_TIME=900
# Mayor plano por cuenta — bridge ctamov/subdiario; subir si meses muy cargados (config/contable.php)
MAYOR_PLANO_CUENTA_MEMORY_LIMIT=1024M
MAYOR_PLANO_CUENTA_MAX_EXECUTION_TIME=900
# % del tope CF ARCA para tamaño objetivo de cada lote de facturación del proceso Waitry
# GASTRONOMIA_CIERRE_JORNADA_CF_LOTE_PORCENTAJE_TOPE=20
# Base Informix recepmae/recepmov en informe gerente (informe-gerente gastronomía)
GASTRONOMIA_RECEPCIONES_ANITA_SISTEMA=compras
# Centro de costo recv_ccosto en recepmov (solo líneas de ese CC en grillas y gráficos)
GASTRONOMIA_RECEPCIONES_CENTRO_COSTO_CODIGO=85

# Canje de premios Wigos (POS gastronomía)
# Requiere pdo_sqlsrv + ODBC Driver 18. Equivalente al track_wigos.php legacy (FreeTDS sin TLS).
# WIGOS_HABILITADO=false
# CURR_WIGOS=A
# WIGOS_A_HOST=
# WIGOS_A_PORT=1433
# WIGOS_A_DATABASE=wgdb_000
# WIGOS_A_USERNAME=reader_anita
# WIGOS_A_PASSWORD=
# WIGOS_B_HOST=
# Conexión SQL Server (override si el server tiene TLS):
#   WIGOS_ENCRYPT=no                      # "yes" si el SQL Server soporta TLS
#   WIGOS_TRUST_SERVER_CERTIFICATE=yes    # "no" sólo con cert válido
#   WIGOS_LOGIN_TIMEOUT=5                 # segundos
#   WIGOS_APPNAME=AnitaERP-Gastronomia-Wigos
# OpenSSL local para subproceso ODBC Wigos (SQL 2012 + OpenSSL 3); no toca SOAP/ARCA:
#   WIGOS_OPENSSL_CONF=/ruta/anitaERP/config/openssl/wigos-mssql.cnf
# (putenv en el mismo PHP no alcanza; se usa scripts/wigos-sqlserver.php con env OPENSSL_CONF)
# Bajo php-fpm definir el CLI (PHP_BINARY suele venir vacío):
#   WIGOS_PHP_BINARY=/usr/bin/php8.3
# Diagnóstico: php artisan wigos:probar-conexion [--empresa=2] [--cupon=...] [--trackdata=...]
# Servidores Wigos por empresa (JSON). SQL: Kandiko serverwigosksaa/b; Rebisco serverwigosrsaa/b.
# HTTP AccountInfo: si rsaa no responde desde el host ERP, usar account_info_url → serverwigosws (WIGOS_ACCOUNT_INFO_URL).
# Ej.: WIGOS_POR_EMPRESA={"3":{"curr_wigos":"A","account_info_url":"http://serverwigosws:7788/WIGOS/AccountInfoJSON?trackdata=%s","connections":{"A":{"host":"serverwigosrsaa"},"B":{"host":"serverwigosrsab"}}}}
# WIGOS_POR_EMPRESA=
# Rendición gastronomía caja → Informix rendgastro / rendvalor (bridge Anita)
# RENDICION_GASTRONOMIA_SINCRONIZAR_ANITA=true
# RENDICION_GASTRONOMIA_ANITA_SISTEMA=caja
# RENDICION_GASTRONOMIA_ANITA_TIPO_OPER=F
# Auditoría diaria rendg_total_z / rendg_tot_nc vs ERP (schedule @ RENDICION_GASTRONOMIA_AUDITORIA_HORA)
# RENDICION_GASTRONOMIA_AUDITORIA_DIARIA=true
# RENDICION_GASTRONOMIA_AUDITORIA_HORA=07:00
# RENDICION_GASTRONOMIA_AUDITORIA_EMPRESA_ID=1
# RENDICION_GASTRONOMIA_AUDITORIA_EMPRESAS_IDS=1,2,3
# RENDICION_GASTRONOMIA_NRO_OPER_PISO_KANDIKO=200001
# RENDICION_GASTRONOMIA_NRO_OPER_TECHO_KANDIKO=300000
# RENDICION_GASTRONOMIA_NRO_OPER_PISO_REBISCO=300001
# RENDICION_GASTRONOMIA_NRO_OPER_TECHO_REBISCO=400000
# RENDICION_GASTRONOMIA_AUDITORIA_TOLERANCIA=0.02
# PV estacionamiento (facturan solo en Anita; no comparar con ERP gastronomía)
# RENDICION_GASTRONOMIA_AUDITORIA_PV_SOLO_ANITA=00013,00017,00037,00042,00045,00050,00051,00072,00073,00074

# Rendiciones estacionamiento caja → rendgastro/rendvalor (misma tabla Informix; PV propios de estacionamiento)
# RENDICION_ESTACIONAMIENTO_SINCRONIZAR_ANITA=true
# RENDICION_ESTACIONAMIENTO_ANITA_SISTEMA=caja
# RENDICION_ESTACIONAMIENTO_ANITA_TIPO_OPER=F
# Auditoría diaria rendg_total_z / rendg_tot_nc vs ERP estacionamiento (schedule @ RENDICION_ESTACIONAMIENTO_AUDITORIA_HORA)
# RENDICION_ESTACIONAMIENTO_AUDITORIA_DIARIA=true
# RENDICION_ESTACIONAMIENTO_AUDITORIA_HORA=07:30
# RENDICION_ESTACIONAMIENTO_AUDITORIA_EMPRESA_ID=1
# RENDICION_ESTACIONAMIENTO_AUDITORIA_TOLERANCIA=0.02

# Facturación estacionamiento (módulo Caja). Solo AGG por defecto; false oculta menú y rutas.
# ESTACIONAMIENTO_HABILITADO=true
# Exigir jornada abierta antes de facturar estacionamiento
# ESTACIONAMIENTO_JORNADA_OBLIGATORIA=true
# Identificador PC terminal estacionamiento (hostname del servidor si vacío; debe coincidir con configuracion_puntoventa_estacionamiento.identificador_pc)
# Debe coincidir con identificador_pc del ABM configuracion_puntoventa_estacionamiento (fallback si no hay IP cliente)
# ESTACIONAMIENTO_IDENTIFICADOR_PC=192.168.40.151
# true = usar IP del navegador como identificador_pc (recomendado con varias cajas en LAN)
# ESTACIONAMIENTO_IDENTIFICADOR_USAR_IP_CLIENTE=true
# true = exige habilitación de turno por PC antes de operar
# ESTACIONAMIENTO_REQUIERE_HABILITACION_TURNO=true
# true = bloquear cierre turno/jornada si hay ticket de ingreso de auto sin salida (requiere flujo futuro de ingreso)
# ESTACIONAMIENTO_VALIDAR_TICKETS_INGRESO_AL_CERRAR=false
# Uso cuenta caja para medios de cobro POS (tabla usocuentacaja; nombre "Estacionamiento")
# ESTACIONAMIENTO_USO_CUENTACAJA_ID=
# Cliente interno del descuento por defecto (codigo maestro)
# ESTACIONAMIENTO_CLIENTE_DESCUENTO_CODIGO=501
# Cuenta caja efectivo por empresa para F5: JSON empresa_id => cuentacaja_id
# ESTACIONAMIENTO_CUENTACAJA_EFECTIVO_POR_EMPRESA={"1":25,"2":24,"3":23}
# ESTACIONAMIENTO_MONEDA_FACTURA_ID=1
# ESTACIONAMIENTO_TIPO_TRANSACCION_CAJA_ID=
# ESTACIONAMIENTO_TIPO_TRANSACCION_FACTURA_ID=
# ESTACIONAMIENTO_TIPO_TRANSACCION_NOTA_CREDITO_ID=
# ESTACIONAMIENTO_TIPO_TRANSACCION_CAJA_DEVOLUCION_ID=3
# ESTACIONAMIENTO_CONSUMIDOR_FINAL_CONDICIONIIBB_ID=4
# ESTACIONAMIENTO_IMPUESTO_EXENTO_ID=1
# false: no genera contabilidad al facturar (facturas y notas de crédito)
# ESTACIONAMIENTO_GENERA_CONTABILIDAD_FACTURA=false
# false: no genera contabilidad al cobrar (F5 efectivo y devolución NC)
# ESTACIONAMIENTO_GENERA_CONTABILIDAD_COBRANZA=false
# Replica venta en Informix (Anita bridge) al facturar desde estacionamiento (sin stkmov)
ESTACIONAMIENTO_SINCRONIZAR_ANITA=true
# Anita tras responder al POS (defer Laravel terminating); no bloquea cobranza
ESTACIONAMIENTO_ANITA_TRAS_RESPUESTA=true
# Tras commit MySQL: diferir Anita (anita_pendiente) en lugar de bloquear la transacción
# ESTACIONAMIENTO_ANITA_TRAS_COMMIT_AL_FACTURAR=true
# ESTACIONAMIENTO_EMISION_LOCK_SEGUNDOS=180
# ESTACIONAMIENTO_TICKET_IMPRESION_AUTOMATICA=true
# ESTACIONAMIENTO_TICKET_IMPRESION_ASYNC=true
# ESTACIONAMIENTO_TICKET_ANCHO=42
# ESTACIONAMIENTO_TICKET_CODIFICACION=ISO-8859-1
# ESTACIONAMIENTO_TICKET_QR_SIZE=6
# ESTACIONAMIENTO_TICKET_COMANDO_TIMEOUT=30
# ESTACIONAMIENTO_TICKET_GUARDAR_PREVIEW=true
# ESTACIONAMIENTO_LISTAPRECIO_ID=1

# GASTRONOMIA_CANJE_PREMIO_DESCUENTO_CODIGO=10
# GASTRONOMIA_CANJE_PREMIO_CLIENTE_CODIGO=500
# GASTRONOMIA_CANJE_PREMIO_VENCIMIENTO_DIAS=2

# Facturador canjes marketing (menú Canjes → comandera en sala)
# GASTRONOMIA_CANJE_MARKETING_DESCUENTO_CODIGO=40
# GASTRONOMIA_CANJE_MARKETING_REQUIERE_HABILITACION_TURNO=false
# GASTRONOMIA_CANJE_MARKETING_CUBIERTOS_OBLIGATORIO=false
# GASTRONOMIA_CANJE_MARKETING_GENERA_CONTABILIDAD_FACTURA=false
# Listado canjes marketing: código lista precios CMV (Anita prem_lista; ej. 50 = COSTO A&B)
# GASTRONOMIA_CANJE_MARKETING_LISTADO_LISTAPRECIO_CMV_CODIGO=50

# external_id = venta.id; orderId de respuesta → cuenta_gastronomia.waitry_order_id
# WAITRY_HABILITADO=false
# WAITRY_CLIENT_ID=
# WAITRY_CLIENT_SECRET=
# WAITRY_USER=
# WAITRY_PASSWORD=
# WAITRY_TABLE_POR_EMPRESA={"1":{"tableId":101066},"2":{"tableId":101067},"3":{"tableId":101068}}
# WAITRY_PLACE_ID_POR_EMPRESA={"1":11782,"2":11783,"3":11784}
# WAITRY_GET_ORDERS_MINUTOS_ATRAS=20
# WAITRY_GET_ORDERS_CACHE_SEGUNDOS=15
# WAITRY_GET_ORDERS_USAR_DETALLES_FALLBACK=false
# Anita → Waitry: solo MP/Totalcoin conservan tipo; resto va como cash (ver WAITRY_TIPO_PAGO_CUENTACAJA).
# Lecturas Waitry (tótem) → cuenta caja Anita. Gastronomía: QR y Posnet/MP a la misma cuenta MP (201);
# totalcoin sigue mapeado por separado para identificar QR en Waitry y poder abrir otro medio en el futuro.
# WAITRY_TIPO_PAGO_CUENTACAJA={"mercadopago":201,"totalcoin":201}
# Gateway payment.payments en pushExternalOrder (Control Z); opcional override por tipo
# WAITRY_PAGO_GATEWAY_POR_TIPO={"mercadopago":"MERCADOPAGO","totalcoin":"TOTALCOIN","cash":"CASH"}
# WAITRY_SYNC_STATUS_POS_EVENT=accepted
# docs/waitry/README.md
# php artisan waitry:probar-conexion --empresa=1 --renovar

# Padrón ARCA (config/arca.php → padron.*) — consulta constancia de inscripción de terceros
# ARCA_ENV=prod
# ARCA_CUIT_REPRESENTADA=30XXXXXXXXXX
# Certificados padrón: storage/app/arca/sr_padron/certs/ (o ARCA_CERT_PATH / ARCA_PADRON_BASE)
# La factura electrónica (WSFE) NO usa ARCA_CUIT_REPRESENTADA: usa empresa.nroinscripcion en MySQL.

# WSFEv1 (config/arca_wsfe.php) — carpeta de certs según EMPRESA: storage/app/arca/wsfe/certs/{carpeta}/
# EL BIERZO → bierzo | AGG → biyemas/kandiko/rebisco (ver empresas_por_entorno en config)
# ARCA_WSFE_TRANSPORTE=soap
# ARCA_WSFE_CARPETA_CERT=bierzo
# ARCA_WSFE_EMPRESAS_JSON={"1":"bierzo"}
# Umbral CF sin identificación (pesos). Compartido POS gastronomía y cierre Waitry.
# ARCA_WSFE_RECEPTOR_CF_UMBRAL_MONTO=417288
# ARCA_WSFE_RECEPTOR_CF_RAZON_SOCIAL=CONSUMIDOR FINAL
# ARCA_WSFE_RECEPTOR_CF_TIPO_DOCUMENTO=99
# ARCA_WSFE_RECEPTOR_CF_NUMERO_DOCUMENTO=0
# ARCA_WSFE_RECEPTOR_CLIENTE_ERP_INTERNO_ID=
# ARCA_WSFE_RECEPTOR_CF_CONDICION_IVA_ID=3
# ARCA_WSFE_RECEPTOR_IDENTIFICADO_TIPO_DOCUMENTO=96
# Contingencia: true = emite por PV CAEA sin consultar ARCA en línea (AFIP caído / mantenimiento)
ARCA_WSFE_FORZAR_MODO_CAEA=false
# ARCA_WSFE_REINTENTAR_CAEA_SI_FALLA_COMUNICACION=true
# Timeout SOAP en POS (gastronomía); más corto que ARCA_WSFE_SOAP_TIMEOUT para no bloquear al cajero
# ARCA_WSFE_SOAP_TIMEOUT_POS=18
# Monitor conectividad (schedule cada 5 min): activa failover CAEA en runtime sin tocar .env
# ARCA_MONITOR_CONECTIVIDAD=true
# ARCA_MONITOR_EMPRESA_ID=1
# ARCA_MONITOR_PUNTOVENTA_ID=4
# ARCA_MONITOR_TIPOTRANSACCION_ID=
# ARCA_MONITOR_CBTE_TIPO=6
# ARCA_MONITOR_FALLOS_PARA_ACTIVAR=2
# ARCA_MONITOR_OK_PARA_DESACTIVAR=2

# WSMTXCA (config/arca_mtxca.php) — factura con detalle / codificación productos
# Punto de venta: webservice=wsmtxca. Certificados: storage/app/arca/mtxca/certs/{carpeta}/
# ARCA_MTXCA_TRANSPORTE=soap
# ARCA_MTXCA_CARPETA_CERT=bierzo
# ARCA_MTXCA_EMPRESAS_JSON={"1":"bierzo"}
# ARCA_MTXCA_FORZAR_MODO_CAEA=false
# ARCA_MTXCA_REINTENTAR_CAEA_SI_FALLA_COMUNICACION=true
# Pedido quincenal automático (schedule 06:30): arca:solicitar-caea-quincenal → arca_caea vía ARCA
# false: no corre en cron; sigue manual (artisan / pantalla CAEA ARCA)
# ARCA_CAEA_PEDIDO_AUTOMATICO=true
# Réplica CAEA en Informix (tabla caea) tras cada solicitud ARCA exitosa
# ARCA_CAEA_REPLICAR_ANITA=true
# Import Anita (una sola vez, histórico): php artisan arca:importar-caea-anita

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SuiteCRM 8 — cuenta y notas en CRUD de clientes
# Permisos: listar-notas-suitecrm-cliente, gestionar-notas-suitecrm-cliente, sincronizar-cuenta-suitecrm-cliente, ver-notas-supervisor-suitecrm-cliente
SUITECRM_HABILITADO=false
SUITECRM_LEGACY_CONFIG_PATH=/var/www/html/suitcrm8/public/legacy/config.php
SUITECRM_DEFAULT_USER_ID=1
# Rol acl_roles en SuiteCRM cuyas notas son restringidas (usuarios como mgomez)
SUITECRM_SUPERVISOR_ROL_NOMBRE=Supervisor
