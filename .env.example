APP_NAME=Laravel
APP_ENV=local
# En production los comandos migrate:fresh, db:wipe, db:seed, etc. están bloqueados.
# ALLOW_DESTRUCTIVE_ARTISAN=true  # solo emergencia temporal; nunca dejar habilitado
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# database = colas reales (requiere worker: deploy/queue/aplicar-supervisor.sh)
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Compras / requisición: true = listado y EN_COMPRAS filtran por oficina de compra del usuario
REQUISICION_FILTRO_OFICINA_COMPRAS_ACTIVO=false

# true = al abrir el listado de artículos se sincroniza con Anita en la misma petición (riesgo de timeout)
ANITA_SYNC_ARTICULO_INDEX=false

# true = muestra el botón "Sincronizar desde Anita" en el índice de fórmulas de artículos (POST sigue bloqueado si es false)
ANITA_SYNC_FORMULA_ARTICULO_INDEX=true

# true = en el CRUD de fórmulas se muestra el "código" como número visible (listado, modal, título de edición,
# etiquetas de subfórmula, exportaciones) en lugar del id interno. Las URLs/rutas siguen usando id.
# Si una fórmula no tiene código cargado, se muestra "#<id>" como fallback.
FORMULA_ARTICULO_MOSTRAR_CODIGO_COMO_NUMERO=false

# Import masivo desde Anita sin pasar por el navegador (evita 504): php artisan articulo:sincronizar-anita
# Clientes nuevos/actualizados desde climae: php artisan cliente:sincronizar-anita
# Un solo cliente: php artisan cliente:sincronizar-anita --codigo=001234

# Órdenes de compra: sincronización desde pendmaep (misma lógica que requisiciones)
ORDENCOMPRA_SYNC_ANITA_INDEX=false
ORDENCOMPRA_SYNC_ANITA_FECHA_DESDE=20250100
# php artisan ordencompra:sincronizar-anita
# php artisan ordencompra:sincronizar-anita --nro=12345

# Lista de precios por defecto en modal de consulta de artículos (id numérico, típ. 1).
# LISTAPRECIO_DEFAULT_ID=1

# Impuesto interno (p. ej. cigarrillos): coeficientes por insumo en listas de precios.
# Mapa empresa_id => código de listaprecio del coeficiente (vigente al facturar).
# Default AGG: BIYEMAS=162, KANDIKO=262, REBISCO=362.
# Si un ítem facturado tiene en su fórmula (insumos o opcionales elegidos) un artículo con
# tipoarticulo configurado abajo, se aplica precio*coef como impuesto interno y se descuenta
# del bruto antes de calcular el neto/IVA. El total del concepto se agrega a la factura y
# se reporta a ARCA como tributo Id=4 (Impuestos Internos).
# FACTURACION_IMPUESTO_INTERNO_LISTAS_POR_EMPRESA={"1":"162","2":"262","3":"362"}
# FACTURACION_IMPUESTO_INTERNO_TIPOARTICULO_NOMBRE=CIGARRILLO

# Mesas gastronomía: sincronización desde tabla mesa (Anita)
MESA_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_MESA_GASTRONOMIA_INDEX=true
MESA_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# MESA_GASTRONOMIA_SYNC_EMPRESA_ID=1
# php artisan mesa-gastronomia:sincronizar-anita
# php artisan mesa-gastronomia:sincronizar-anita --codigo=12

# Descuentos gastronomía: sincronización desde tabla descuento (Anita)
DESCUENTO_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_DESCUENTO_GASTRONOMIA_INDEX=true
DESCUENTO_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# php artisan descuento-gastronomia:sincronizar-anita
# php artisan descuento-gastronomia:sincronizar-anita --codigo=1

# Mozos gastronomía: sincronización desde tabla vendedor (Anita)
MOZO_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_MOZO_GASTRONOMIA_INDEX=true
MOZO_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# MOZO_GASTRONOMIA_SYNC_EMPRESA_ID=1
# php artisan mozo-gastronomia:sincronizar-anita
# php artisan mozo-gastronomia:sincronizar-anita --codigo=12

# Categorías fidelidad gastronomía: clicat + clicatart + entregas clicatent (Anita)
CATEGORIA_FIDELIDAD_GASTRONOMIA_SYNC_ANITA_INDEX=false
ANITA_SYNC_CATEGORIA_FIDELIDAD_GASTRONOMIA_INDEX=true
CATEGORIA_FIDELIDAD_GASTRONOMIA_SYNC_ANITA_SISTEMA=ventas
# Fecha mínima Ymd para importar entregas clicatent (20250101 = 1/1/2025)
CATEGORIA_FIDELIDAD_GASTRONOMIA_SYNC_ANITA_FECHA_DESDE=20250101
# clcent_categoria=0 en Anita → categoría ERP por defecto (3 = Platino)
CATEGORIA_FIDELIDAD_GASTRONOMIA_ENTREGA_CATEGORIA_DEFAULT=3
# php artisan categoria-fidelidad-gastronomia:sincronizar-anita
# php artisan categoria-fidelidad-gastronomia:sincronizar-anita --codigo=1

# Puntos de venta: sincronización desde tabla sucursal (Anita)
ANITA_SYNC_PUNTOVENTA_INDEX=false
# Replicar altas/ediciones/bajas del ABM hacia Anita (tabla sucursal). Dejar en false mientras se ajustan empresas/PV.
ANITA_SYNC_PUNTOVENTA_WRITE=false
# PUNTOVENTA_SYNC_ANITA_SISTEMA=ventas
# PUNTOVENTA_SYNC_EMPRESA_ID=3
# Lista de columnas Informix (si el default falla o devuelve 0 filas, copie aquí las columnas reales):
# PUNTOVENTA_SYNC_ANITA_CAMPOS_LISTADO=suc_numero,suc_empresa,...
# PUNTOVENTA_SYNC_DEFAULT_PAIS_ID=1
# PUNTOVENTA_SYNC_DEFAULT_PROVINCIA_ID=3
# PUNTOVENTA_SYNC_DEFAULT_LOCALIDAD_ID=108
# php artisan puntoventa:sincronizar-anita
# php artisan puntoventa:sincronizar-anita --codigo=1

# Gastronomía POS: la empresa la define configuracion_puntoventa_gastronomia por identificador de PC.
# Identificador de terminal (hostname servidor si no se define)
# GASTRONOMIA_IDENTIFICADOR_PC=caja1
# true = usar IP del cliente HTTP como identificador (TrustProxies debe confiar el proxy/nginx)
GASTRONOMIA_IDENTIFICADOR_USAR_IP_CLIENTE=false
# true = habilitación/cierre de turno por PC antes de facturar (AGG). false = caja directo.
GASTRONOMIA_REQUIERE_HABILITACION_TURNO=true
# Apertura de mesa/cuenta en el POS
# GASTRONOMIA_CUBIERTOS_OBLIGATORIO_AL_ABRIR=true
# GASTRONOMIA_CUBIERTOS_DEFAULT_AL_ABRIR=1
# GASTRONOMIA_MOZO_OBLIGATORIO_AL_ABRIR=true
# GASTRONOMIA_CUENTAS_LIBRES_HABILITADAS=true
# Anita al facturar: replica venta en Informix vía bridge al emitir desde el POS.
# GASTRONOMIA_SINCRONIZAR_ANITA=true
# true = venta + vengrav + stkmov + vencae (gastronomía). false = grabaAnita completo como Ventas.
# GASTRONOMIA_ANITA_MODO_MINIMO=true

# Auditoría diaria ERP ↔ Anita (schedule: gastronomia:auditoria-anita-diaria @ GASTRONOMIA_AUDITORIA_ANITA_HORA)
# Día auditado = ayer calendario (venta.fecha). Busca comprobante en Anita por sucursal+tipo+nro+letra B.
# Replica faltantes y envía mail si hay alertas (faltantes, errores, delta de total).
# GASTRONOMIA_AUDITORIA_ANITA_DIARIA=true
# GASTRONOMIA_AUDITORIA_ANITA_HORA=06:30
# GASTRONOMIA_AUDITORIA_ANITA_EMPRESA_ID=1
# GASTRONOMIA_AUDITORIA_ANITA_USUARIO_ID=1
# GASTRONOMIA_AUDITORIA_ANITA_EMAIL=sergiogranucci@gmail.com
# GASTRONOMIA_AUDITORIA_ANITA_TOLERANCIA=0.02
# GASTRONOMIA_AUDITORIA_ANITA_REPLICAR_INSUMOS=true
# GASTRONOMIA_AUDITORIA_ANITA_EMAIL_SI_OK=false

# Waitry después de responder al POS (no bloquea emitir-factura)
# GASTRONOMIA_WAITRY_TRAS_RESPUESTA=true
# GASTRONOMIA_EMISION_PROFILE=false
# GASTRONOMIA_EMISION_PROFILE_EN_RESPUESTA=false
# Una sola emisión a la vez por punto de venta fiscal (número ARCA). Segundos de vida del lock en cache.
# GASTRONOMIA_EMISION_LOCK_SEGUNDOS=180

# Numeración tesorería (cobranza + movimiento de caja / Anita tesmov).
# Compartida por empresa_id + tipotransaccion_caja_id: gastronomía al cobrar, ABM cobranza, ingreso/egreso.
# Requiere CACHE_DRIVER con locks (file, redis, database; no array en producción con varias PCs).
# COBRANZA_NUMERACION_LOCK_SEGUNDOS=120
# COBRANZA_NUMERACION_LOCK_ESPERA_SEGUNDOS=90
# Tipos de transacción de caja con numerador secuencial (1,2,…). Gastronomía suele ser id 2 → clave B-00008-00807543 desde ARCA.
# COBRANZA_TIPOTRANSACCION_SECUENCIAL_IDS=1

# Canje ticket tarjeta gastronomía (CTG) — cobranza en facturador, tabla Informix tickettarj
# Código de barras: 6 dígitos imovimientoid + inroticket. Impreso: 554101-52547. EAN (13 dígitos):
# 5541010525473 = movimiento + 0 + nroticket (6) + dígito verificador. Sin guión: 55365952217 → 553659/52217.
# GASTRONOMIA_TICKET_TARJETA_ANITA_SISTEMA = base Informix del bridge (config/anita.php ANITA_BDD_PATH + sistema).
#   base_admin = default histórico tickettarj. ventas = misma tabla en otras instalaciones.
#   NO usar che_ban (cuentas bancarias/cheques): ahí no está tickettarj → "No se encontró el ticket en Anita".
# Cuenta de caja del medio de cobranza (debe existir por empresa):
# GASTRONOMIA_TICKET_TARJETA_CUENTACAJA_CODIGO=CTG
# GASTRONOMIA_TICKET_TARJETA_VENCIMIENTO_DIAS=30
# GASTRONOMIA_TICKET_TARJETA_TOLERANCIA_EXCEDENTE=5
GASTRONOMIA_TICKET_TARJETA_ANITA_SISTEMA=base_admin

# Cierre de jornada — órdenes Waitry del tótem (waitry_order_id). PDF y rango al cerrar jornada gastronomía.
# Requiere WAITRY_HABILITADO=true. Siguiente día: órdenes con id > último waitry_order_id_hasta guardado.
# GASTRONOMIA_CIERRE_TOTEM_JORNADA_HABILITADO=true
# GASTRONOMIA_CIERRE_TOTEM_MAX_ORDENES=15000
# GASTRONOMIA_CIERRE_TOTEM_MAX_LINEAS_DETALLE=3000
# Huecos de secuencia Waitry: ya no se recuperan al cerrar jornada (quedan para auditoría del día).
# GASTRONOMIA_CIERRE_TOTEM_MAX_IDS_GAP_RECUPERAR=0
# Máx. consultas getOrdersPOS por orderId si getordersdetails no trae payment.type (0 = off)
# GASTRONOMIA_CIERRE_TOTEM_ENRIQUECER_PAYMENT_INDIVIDUAL_MAX=0
# GASTRONOMIA_CIERRE_TOTEM_HORA_CORTE_MADRUGADA=7
# GASTRONOMIA_CIERRE_TOTEM_INFORME_Z_TOLERANCIA=0.02
# Punto de venta del proceso inferior de cierre Waitry (JSON empresa_id → código PV). BSA: 00003
# GASTRONOMIA_CIERRE_JORNADA_PUNTOVENTA_CODIGO_POR_EMPRESA={"1":"00003"}
# Base Informix recepmae/recepmov en informe gerente (informe-gerente gastronomía)
GASTRONOMIA_RECEPCIONES_ANITA_SISTEMA=compras
# Centro de costo recv_ccosto en recepmov (solo líneas de ese CC en grillas y gráficos)
GASTRONOMIA_RECEPCIONES_CENTRO_COSTO_CODIGO=85

# Canje de premios Wigos (POS gastronomía)
# Requiere pdo_sqlsrv + ODBC Driver 18. Equivalente al track_wigos.php legacy (FreeTDS sin TLS).
# WIGOS_HABILITADO=false
# CURR_WIGOS=A
# WIGOS_A_HOST=
# WIGOS_A_PORT=1433
# WIGOS_A_DATABASE=wgdb_000
# WIGOS_A_USERNAME=reader_anita
# WIGOS_A_PASSWORD=
# WIGOS_B_HOST=
# Conexión SQL Server (override si el server tiene TLS):
#   WIGOS_ENCRYPT=no                      # "yes" si el SQL Server soporta TLS
#   WIGOS_TRUST_SERVER_CERTIFICATE=yes    # "no" sólo con cert válido
#   WIGOS_LOGIN_TIMEOUT=5                 # segundos
#   WIGOS_APPNAME=AnitaERP-Gastronomia-Wigos
# OpenSSL local para subproceso ODBC Wigos (SQL 2012 + OpenSSL 3); no toca SOAP/ARCA:
#   WIGOS_OPENSSL_CONF=/ruta/anitaERP/config/openssl/wigos-mssql.cnf
# (putenv en el mismo PHP no alcanza; se usa scripts/wigos-sqlserver.php con env OPENSSL_CONF)
# Bajo php-fpm definir el CLI (PHP_BINARY suele venir vacío):
#   WIGOS_PHP_BINARY=/usr/bin/php8.3
# Diagnóstico: php artisan wigos:probar-conexion [--cupon=...] [--trackdata=...]
# Rendición gastronomía caja → Informix rendgastro / rendvalor (bridge Anita)
# RENDICION_GASTRONOMIA_SINCRONIZAR_ANITA=true
# RENDICION_GASTRONOMIA_ANITA_SISTEMA=caja
# RENDICION_GASTRONOMIA_ANITA_TIPO_OPER=F

# GASTRONOMIA_CANJE_PREMIO_DESCUENTO_CODIGO=10
# GASTRONOMIA_CANJE_PREMIO_CLIENTE_CODIGO=500
# GASTRONOMIA_CANJE_PREMIO_VENCIMIENTO_DIAS=2

# Waitry — comandas a cocina tras facturar (Push Orders / pushExternalOrder)
# external_id = venta.id; orderId de respuesta → cuenta_gastronomia.waitry_order_id
# WAITRY_HABILITADO=false
# WAITRY_CLIENT_ID=
# WAITRY_CLIENT_SECRET=
# WAITRY_USER=
# WAITRY_PASSWORD=
# WAITRY_TABLE_POR_EMPRESA={"1":{"tableId":101066},"2":{"tableId":101067},"3":{"tableId":101068}}
# WAITRY_PLACE_ID_POR_EMPRESA={"1":11782,"2":11783,"3":11784}
# WAITRY_GET_ORDERS_MINUTOS_ATRAS=20
# WAITRY_GET_ORDERS_CACHE_SEGUNDOS=15
# WAITRY_GET_ORDERS_USAR_DETALLES_FALLBACK=false
# Anita → Waitry: solo MP/Totalcoin conservan tipo; resto va como cash (ver WAITRY_TIPO_PAGO_CUENTACAJA).
# Lecturas Waitry (tótem) → cuenta caja Anita: mercadopago→201, totalcoin→226 (default multiempresa)
# WAITRY_TIPO_PAGO_CUENTACAJA={"mercadopago":201,"totalcoin":226}
# WAITRY_SYNC_STATUS_POS_EVENT=accepted
# docs/waitry/README.md
# php artisan waitry:probar-conexion --empresa=1 --renovar

# Padrón ARCA (config/arca.php → padron.*) — consulta constancia de inscripción de terceros
# ARCA_ENV=prod
# ARCA_CUIT_REPRESENTADA=30XXXXXXXXXX
# Certificados padrón: storage/app/arca/sr_padron/certs/ (o ARCA_CERT_PATH / ARCA_PADRON_BASE)
# La factura electrónica (WSFE) NO usa ARCA_CUIT_REPRESENTADA: usa empresa.nroinscripcion en MySQL.

# WSFEv1 (config/arca_wsfe.php) — carpeta de certs según EMPRESA: storage/app/arca/wsfe/certs/{carpeta}/
# EL BIERZO → bierzo | AGG → biyemas/kandiko/rebisco (ver empresas_por_entorno en config)
# ARCA_WSFE_TRANSPORTE=soap
# ARCA_WSFE_CARPETA_CERT=bierzo
# ARCA_WSFE_EMPRESAS_JSON={"1":"bierzo"}
# ARCA_WSFE_RECEPTOR_CF_UMBRAL_MONTO=10000000
# ARCA_WSFE_RECEPTOR_CF_RAZON_SOCIAL=CONSUMIDOR FINAL
# ARCA_WSFE_RECEPTOR_CF_TIPO_DOCUMENTO=99
# ARCA_WSFE_RECEPTOR_CF_NUMERO_DOCUMENTO=0
# ARCA_WSFE_RECEPTOR_CLIENTE_ERP_INTERNO_ID=
# ARCA_WSFE_RECEPTOR_CF_CONDICION_IVA_ID=3
# ARCA_WSFE_RECEPTOR_IDENTIFICADO_TIPO_DOCUMENTO=96
# ARCA_WSFE_FORZAR_MODO_CAEA=false
# ARCA_WSFE_REINTENTAR_CAEA_SI_FALLA_COMUNICACION=true
# Monitor conectividad (schedule cada 5 min): activa failover CAEA en runtime sin tocar .env
# ARCA_MONITOR_CONECTIVIDAD=true
# ARCA_MONITOR_EMPRESA_ID=1
# ARCA_MONITOR_PUNTOVENTA_ID=4
# ARCA_MONITOR_TIPOTRANSACCION_ID=
# ARCA_MONITOR_CBTE_TIPO=6
# ARCA_MONITOR_FALLOS_PARA_ACTIVAR=2
# ARCA_MONITOR_OK_PARA_DESACTIVAR=2

# WSMTXCA (config/arca_mtxca.php) — factura con detalle / codificación productos
# Punto de venta: webservice=wsmtxca. Certificados: storage/app/arca/mtxca/certs/{carpeta}/
# ARCA_MTXCA_TRANSPORTE=soap
# ARCA_MTXCA_CARPETA_CERT=bierzo
# ARCA_MTXCA_EMPRESAS_JSON={"1":"bierzo"}
# ARCA_MTXCA_FORZAR_MODO_CAEA=false
# ARCA_MTXCA_REINTENTAR_CAEA_SI_FALLA_COMUNICACION=true
# Pedido quincenal automático (schedule 06:30): arca:solicitar-caea-quincenal → arca_caea vía ARCA
# false: no corre en cron; sigue manual (artisan / pantalla CAEA ARCA)
# ARCA_CAEA_PEDIDO_AUTOMATICO=true
# Réplica CAEA en Informix (tabla caea) tras cada solicitud ARCA exitosa
# ARCA_CAEA_REPLICAR_ANITA=true
# Import Anita (una sola vez, histórico): php artisan arca:importar-caea-anita

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SuiteCRM 8 — cuenta y notas en CRUD de clientes
# Permisos: listar-notas-suitecrm-cliente, gestionar-notas-suitecrm-cliente, sincronizar-cuenta-suitecrm-cliente, ver-notas-supervisor-suitecrm-cliente
SUITECRM_HABILITADO=false
SUITECRM_LEGACY_CONFIG_PATH=/var/www/html/suitcrm8/public/legacy/config.php
SUITECRM_DEFAULT_USER_ID=1
# Rol acl_roles en SuiteCRM cuyas notas son restringidas (usuarios como mgomez)
SUITECRM_SUPERVISOR_ROL_NOMBRE=Supervisor
