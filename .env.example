# Cierre contable de período y aperturas programadas (config/contable_cierre.php)
CONTABLE_CIERRE_RECORDATORIO_HORAS=2
CONTABLE_CIERRE_JOB_INTERVALO_MIN=15
CONTABLE_CIERRE_APERTURA_LINK_DIAS=7
# Hora (HH:MM) para aplicar cierres programados el día de fecha_ejecucion
CONTABLE_CIERRE_HORA_FIN_DIA=23:50
# Saldos mensuales por cuenta (cuentacontable_saldo_mes + observer)
# true = mantiene saldos al grabar asientos (activar tras reconstruir)
CONTABLE_SALDOS_CUENTA_MES_OBSERVER=true
CONTABLE_SALDOS_CUENTA_MES_MONEDA_LOCAL_ID=1
# Control nocturno de integridad del snapshot mensual (contable:verificar-saldos-cuenta-mes)
# EMPRESAS: solo las operativas (1 Biyemas, 2 Kandiko, 3 Rebisco); VENTANA_MESES 0 = histórico completo
CONTABLE_SALDOS_INTEGRIDAD_HABILITADA=true
CONTABLE_SALDOS_INTEGRIDAD_HORA=06:10
CONTABLE_SALDOS_INTEGRIDAD_EMAIL=avisos@empresa.com
CONTABLE_SALDOS_INTEGRIDAD_EMPRESAS=1,2,3
CONTABLE_SALDOS_INTEGRIDAD_VENTANA_MESES=24
CONTABLE_SALDOS_INTEGRIDAD_MAIL_SIEMPRE=false
# Distribución automática de informes definibles por mail (contable:distribuir-reportes-definibles,
# corre cada hora; el día y la hora los define cada suscripción en la solapa Distribución)
CONTABLE_REPORTE_DEFINIBLE_DISTRIBUCION=true
# Distribución automática de listados definibles de sueldos (sueldos:distribuir-reportes-definibles,
# corre cada hora; el día y la hora los define cada suscripción en la solapa Distribución)
SUELDOS_REPORTE_DEFINIBLE_DISTRIBUCION=true
# Flash Report AGG (caja/flash/reporte). Corre cada hora; cada envío define día y hora.
FLASH_REPORTE_AGG_DISTRIBUCION=true
# Colas dedicadas reportes sueldos (Supervisor reports / reports-mail)
SUELDOS_REPORTE_DEFINIBLE_COLA=reports
SUELDOS_REPORTE_DEFINIBLE_COLA_MAIL=reports-mail
SUELDOS_REPORTE_DEFINIBLE_JOB_TRIES=3
SUELDOS_REPORTE_DEFINIBLE_LEASE_MINUTOS=30
# Balance sumas y saldos
SUMAS_SALDOS_MEMORY_LIMIT=1024M
SUMAS_SALDOS_MAX_EXECUTION_TIME=600

